{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caliper Studio",
  "version": "0.2.1",
  "identifier": "com.sannikov.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Caliper Studio",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "caliper-studio",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0NUZCMzNFQUFGOUQ1QTYKUldTbTFmbXFQck5mRkhOM3k5ZUJOTy9KOXViME1MVkpSRjZZT01mSUN5bk5Rc1NKbjJ4QUZiWE0K",
      "endpoints": [
        "https://github.com/msannikov03/caliper/releases/latest/download/latest.json"
      ]
    }
  }
}